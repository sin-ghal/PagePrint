# Copy this file to .env and fill in real values.
# docker-compose reads server/.env via env_file.

# Auth
JWT_SECRET=your_jwt_secret

# Database
# In docker-compose this is overridden to mongodb://mongo:27017/pagePrint.
# For a local (non-docker) run, use your own URL, e.g. Atlas.
MONGODBURL=mongodb://localhost:27017/pagePrint

# Email (Brevo)
BREVO_API_KEY=your_brevo_api_key

# Cloudinary
CLOUD_NAME=your_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# CORS / frontend origin
FRONTEND_URL=http://localhost:3000

# Server port
PORT=4000
